{
  "redirects": [
    { "source": "/zi", "destination": "https://zi.fuluoyide.top/", "permanent": true },
    { "source": "/zi/:path*", "destination": "https://zi.fuluoyide.top/:path*", "permanent": true }
  ],
  "rewrites": [
    {
      "source": "/work/:slug",
      "destination": "/index.html"

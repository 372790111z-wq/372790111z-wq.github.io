{
  "redirects": [
    {
      "source": "/zi",
      "destination": "https://zi.fuluoyide.top/",
      "permanent": true
    },
    {
      "source": "/zi/",
      "destination": "https://zi.fuluoyide.top/",
      "permanent": true
    },
    {
      "source": "/zi/:path*",
      "destination": "https://zi.fuluoyide.top/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/private/sync",
      "destination": "/api/training-sync"
    },
    {
      "source": "/private/:path*",
      "destination": "/api/training"
    },
    {
      "source": "/work/:slug",
      "destination": "/index.html"
    },
    {
      "source": "/models",
      "destination": "/index.html"
    },
    {
      "source": "/about",
      "destination": "/index.html"
    },
    {
      "source": "/writing",
      "destination": "/index.html"
    },
    {
      "source": "/contact",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/private/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow, noarchive"
        },
        {
          "key": "Cache-Control",
          "value": "private, no-store, max-age=0"
        }
      ]
    }
  ]
}
